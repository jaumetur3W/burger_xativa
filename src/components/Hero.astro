---
import Icon from './Icon.astro';
---
<section id="inicio" class="relative isolate flex min-h-[720px] items-center justify-center overflow-hidden bg-ink px-5 pb-12 pt-32 text-center md:min-h-[850px] md:px-10">
  <picture class="absolute inset-0 -z-20 block h-full w-full">
    <source type="image/avif" srcset="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?fit=crop&w=900&q=72&fm=avif 900w, https://images.unsplash.com/photo-1568901346375-23c9450c58cd?fit=crop&w=1500&q=72&fm=avif 1500w, https://images.unsplash.com/photo-1568901346375-23c9450c58cd?fit=crop&w=2200&q=72&fm=avif 2200w" sizes="100vw" />
    <source type="image/webp" srcset="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?fit=crop&w=900&q=72&fm=webp 900w, https://images.unsplash.com/photo-1568901346375-23c9450c58cd?fit=crop&w=1500&q=72&fm=webp 1500w, https://images.unsplash.com/photo-1568901346375-23c9450c58cd?fit=crop&w=2200&q=72&fm=webp 2200w" sizes="100vw" />
    <img class="h-full w-full object-cover object-center opacity-55" src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?fit=crop&w=1500&q=72&fm=webp" alt="Hamburguesa doble con queso fundido, imagen ilustrativa" fetchpriority="high" loading="eager" decoding="async" width="2200" height="1467" />
  </picture>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/55 via-ink/25 to-ink"></div><div class="grain pointer-events-none absolute inset-0 -z-10 opacity-20"></div>
  <div class="mx-auto w-full max-w-7xl">
    <p class="hero-enter mb-5 inline-flex flex-wrap items-center justify-center gap-2 border border-white/15 bg-ink/75 px-3 py-2 text-[10px] font-black uppercase tracking-[.16em] text-white/80 backdrop-blur [animation-delay:80ms]"><span id="open-status-dot" class="h-2 w-2 rounded-full bg-white/50" aria-hidden="true"></span><span id="open-status" aria-live="polite">Consultando horario…</span><span class="text-white/55">· Xàtiva · DEMO</span></p>
    <h1 class="hero-enter display kinetic-title mx-auto text-[clamp(5.2rem,22vw,20rem)] leading-[.72] text-white [animation-delay:160ms]" data-kinetic-title data-title-variant="final">BURGER<span class="text-lime">.</span></h1>
    <div class="hero-enter mx-auto mt-8 flex max-w-3xl flex-col items-center gap-7 [animation-delay:280ms]">
      <p class="max-w-2xl text-base leading-7 text-white/80 md:text-xl md:leading-8">Carne a la brasa, queso que se desborda y cero ganas de compartir. La burger que Xàtiva no sabía que necesitaba.</p>
      <div class="flex flex-wrap justify-center gap-3"><a href="#menu" class="focus-ring inline-flex items-center gap-2 bg-lime px-6 py-4 text-xs font-black uppercase tracking-wider text-ink transition hover:bg-white">Ver menú <Icon name="chevron-down" /></a><a href="#reservas" class="focus-ring inline-flex items-center gap-2 border border-white/50 bg-black/30 px-6 py-4 text-xs font-black uppercase tracking-wider backdrop-blur transition hover:border-lime hover:text-lime">Reservar o pedir <Icon name="arrow-up-right" /></a></div>
    </div>
    <p class="hero-enter mt-12 text-[10px] uppercase tracking-[.18em] text-white/55 [animation-delay:400ms]">Proyecto de portfolio · Marca y datos de ejemplo</p>
  </div>
  <div class="absolute bottom-7 right-6 hidden text-[10px] font-bold uppercase tracking-[.3em] text-white/55 lg:block">Brasa · barrio · buenos ingredientes</div>
</section>

<script>
  const openStatus = document.querySelector<HTMLElement>('#open-status');
  const openStatusDot = document.querySelector<HTMLElement>('#open-status-dot');
  function updateOpenStatus() {
    if (!openStatus || !openStatusDot) return;
    const now = new Date();
    const day = now.getDay();
    const minutes = now.getHours() * 60 + now.getMinutes();
    const openDay = [0, 3, 4, 5, 6].includes(day); // Miércoles a domingo, horario de muestra.
    const isOpen = openDay && minutes >= 13 * 60 && minutes < 23 * 60;
    openStatus.textContent = isOpen ? 'Abierto ahora' : 'Cerrado temporalmente';
    openStatusDot.classList.toggle('bg-emerald-400', isOpen);
    openStatusDot.classList.toggle('bg-rose-400', !isOpen);
    openStatusDot.classList.remove('bg-white/50');
    openStatus.setAttribute('aria-label', `${openStatus.textContent}. Horario local orientativo de la demo.`);
  }
  updateOpenStatus();
  window.setInterval(updateOpenStatus, 60_000);

  const title = document.querySelector<HTMLElement>('[data-kinetic-title]');
  if (title && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const typefaces = ['serif', 'mono', 'slab', 'italic', 'industrial', 'mono', 'serif', 'final'];
    let frame = 0;
    const shutter = window.setInterval(() => {
      title.dataset.titleVariant = typefaces[frame] ?? 'final';
      frame += 1;
      if (frame >= typefaces.length) {
        window.clearInterval(shutter);
        title.dataset.titleVariant = 'final';
      }
    }, 145);
  }
</script>
