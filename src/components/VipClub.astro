---
import Icon from './Icon.astro';
---
<section id="club-vip" class="px-5 py-20 md:px-10 md:py-28" aria-labelledby="vip-heading">
  <div class="reveal mx-auto grid max-w-7xl gap-10 border border-lime/30 bg-[#11110d] p-6 md:grid-cols-[1fr_1fr] md:items-center md:p-12">
    <div><span class="inline-flex bg-lime px-3 py-2 text-[9px] font-bold uppercase tracking-[.18em] text-black">Un bocado por la cara · demo</span><h2 id="vip-heading" class="display mt-5 text-4xl leading-[.92] md:text-6xl">Entra al<br /><span class="text-lime">club VIP.</span></h2><p class="mt-5 max-w-lg text-sm leading-6 text-white/60">Novedades, drops de temporada y un entrante de bienvenida. Déjanos tu email y prueba el flujo de alta de la plantilla.</p></div>
    <div>
      <form id="vip-form" class="grid gap-4" aria-describedby="vip-note">
        <div><label class="mb-2 block text-xs font-bold text-white" for="vip-email">Tu email</label><input class="form-control" id="vip-email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="tu@email.com" required /></div>
        <label class="flex cursor-pointer items-start gap-3 text-xs leading-5 text-white/65"><input class="mt-1 h-4 w-4 shrink-0 accent-lime" type="checkbox" name="consent" value="yes" required /><span>Acepto recibir novedades del club VIP. En esta demo no se almacena ni se envía el correo.</span></label>
        <button type="submit" class="focus-ring inline-flex items-center justify-center gap-2 bg-lime px-5 py-4 text-xs font-bold uppercase tracking-wider text-black transition hover:bg-white">Quiero mi bienvenida <Icon name="arrow-up-right" /></button>
      </form>
      <p id="vip-note" class="mt-3 text-[10px] leading-5 text-white/55">Alta ilustrativa: no se guarda el correo ni se envía ningún email.</p>
      <div id="vip-success" class="mt-5 hidden border border-lime/35 bg-lime/5 p-5" role="status" aria-live="polite" tabindex="-1"><p class="display text-xl text-lime">Ya estás en la lista.</p><p id="vip-confirmation" class="mt-2 text-sm leading-6 text-white/70"></p><p class="mt-3 text-[10px] leading-5 text-white/55">Alta simulada. No se ha guardado ningún dato ni enviado ningún email.</p></div>
    </div>
  </div>
</section>

<script>
  const vipForm = document.querySelector<HTMLFormElement>('#vip-form');
  const vipSuccess = document.querySelector<HTMLElement>('#vip-success');
  const vipConfirmation = document.querySelector<HTMLElement>('#vip-confirmation');
  vipForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!vipForm.reportValidity()) return;
    const email = new FormData(vipForm).get('email');
    if (vipConfirmation) vipConfirmation.textContent = `La experiencia de alta para ${String(email)} se ha completado correctamente.`;
    vipForm.hidden = true;
    if (vipSuccess) {
      vipSuccess.classList.remove('hidden');
      vipSuccess.focus();
    }
    window.dispatchEvent(new CustomEvent('app:toast', { detail: { message: 'Alta VIP de demostración completada.' } }));
  });
</script>
