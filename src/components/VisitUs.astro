---
import ReservationForm from './ReservationForm.astro';
import Icon from './Icon.astro';
---
<section id="contacto" class="px-5 py-24 pb-36 md:px-10 md:py-32" aria-labelledby="visit-heading">
  <div class="mx-auto max-w-7xl overflow-hidden border border-white/10 bg-panel">
    <div class="grid md:grid-cols-[1fr_1fr]">
      <div class="p-7 md:p-12"><p class="mb-4 text-[10px] font-black uppercase tracking-[.25em] text-lime">Estamos cerca · datos demo</p><h2 id="visit-heading" class="display text-5xl leading-[.9] md:text-6xl">Nos vemos<br />en <span class="text-lime">Xàtiva.</span></h2>
        <div class="mt-10 grid gap-7 sm:grid-cols-2"><div><p class="text-[10px] font-black uppercase tracking-[.2em] text-white/55">Dirección</p><p class="mt-2 text-sm leading-6">Carrer de l'Exemple, 12<br />46800 Xàtiva, València</p></div><div><p class="text-[10px] font-black uppercase tracking-[.2em] text-white/55">Horario de muestra</p><p class="mt-2 text-sm leading-6">Mié–dom · 13:00–23:00<br />Lun y mar · descanso</p></div></div>
        <div class="mt-9 flex flex-wrap gap-3"><a class="focus-ring inline-flex items-center gap-2 bg-lime px-5 py-4 text-[10px] font-black uppercase tracking-wider text-ink transition hover:bg-white" href="https://www.google.com/maps/search/?api=1&amp;query=X%C3%A0tiva+Valencia" target="_blank" rel="noopener noreferrer">Cómo llegar <Icon name="arrow-up-right" /></a><a class="focus-ring border border-white/25 px-5 py-4 text-[10px] font-black uppercase tracking-wider transition hover:border-lime hover:text-lime" href="tel:+34000000000">Llamar · 000 000 000</a></div>
        <p class="mt-5 text-[10px] text-white/55">Dirección, teléfono y horario ficticios. Actualízalos antes de publicar.</p>
      </div>
      <div class="relative min-h-[320px] overflow-hidden bg-[#222218] md:min-h-[520px]"><div class="absolute inset-0 opacity-30" style="background-image:linear-gradient(45deg,transparent 49%,#aaa 50%,transparent 51%),linear-gradient(-45deg,transparent 49%,#aaa 50%,transparent 51%);background-size:42px 42px"></div><div class="absolute inset-0 bg-gradient-to-br from-lime/10 via-transparent to-ink/70"></div><div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center"><span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-lime text-ink shadow-[0_0_60px_#ffff0066]" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span><p class="display mt-4 text-xl">XÀTIVA</p><p class="mt-1 text-[9px] uppercase tracking-[.2em] text-white/50">Mapa de muestra</p></div><div class="absolute bottom-4 left-4 text-[9px] uppercase tracking-widest text-white/55">Localización ilustrativa · sin mapa externo</div></div>
    </div>
    <div id="reservas"><ReservationForm /></div>
  </div>
</section>
