---
import Icon from './Icon.astro';
const categories = [
  { id: 'burgers', title: 'Burgers', intro: 'Elige tu manera de mancharte las manos.', items: [
    { tag: 'Bestseller', name: 'La indecente', note: 'Doble smash · cheddar curado · cebolla crispy · salsa de la casa', price: '13,90 €', image: 'photo-1550547660-d9450f859349', alt: 'Hamburguesa con queso cheddar y cebolla crujiente', key: 'burger1' },
    { tag: 'Artesanal', name: 'Trufa sin filtro', note: 'Vacuno · crema de trufa · setas a la brasa · parmesano', price: '14,50 €', image: 'photo-1550547660-d9450f859349', alt: 'Hamburguesa artesanal con queso y pan tostado', key: 'burger2' },
    { tag: 'Picante', name: 'La que pica', note: 'Doble smash · jalapeños · cheddar · mayo de chipotle', price: '13,50 €', image: 'photo-1568901346375-23c9450c58cd', alt: 'Hamburguesa con queso, verduras y salsa', key: 'burger3' },
    { tag: 'Plant based', name: 'Verde que te quiero', note: 'Burger vegetal · aguacate · rúcula · mayo cítrica', price: '12,90 €', image: 'photo-1520072959219-c595dc870360', alt: 'Hamburguesa vegetal con aguacate y rúcula', key: 'burger4' },
  ] },
  { id: 'entrantes', title: 'Entrantes', intro: 'Empieza fuerte. Ya veremos cómo acaba.', items: [
    { tag: 'Para compartir', name: 'Patatas sin freno', note: 'Patata gajo · especias de la casa · salsa cheddar', price: '6,50 €', image: 'photo-1573080496219-bb080dd4f877', alt: 'Patatas fritas doradas con especias', key: 'starter1' },
    { tag: 'Nuevo', name: 'Alitas callejeras', note: 'Alitas crujientes · glaseado BBQ · toque de sésamo', price: '8,90 €', image: 'photo-1527477396000-e27163b481c2', alt: 'Alitas de pollo crujientes con salsa', key: 'starter2' },
  ] },
  { id: 'postres', title: 'Postres', intro: 'El último bocado también cuenta.', items: [
    { tag: 'Nuevo', name: 'Brownie volcán', note: 'Chocolate intenso · centro fundente · helado de vainilla', price: '6,20 €', image: 'photo-1606313564200-e75d5e30476c', alt: 'Brownie de chocolate servido como postre', key: 'dessert1' },
    { tag: 'De la casa', name: 'Cheesecake urbana', note: 'Queso cremoso · galleta crujiente · coulis de frutos rojos', price: '6,50 €', image: 'photo-1533134242443-d4fd215305ad', alt: 'Tarta de queso con frutos rojos', key: 'dessert2' },
  ] },
  { id: 'bebidas', title: 'Bebidas', intro: 'Algo frío para bajar el fuego.', items: [
    { tag: 'De aquí', name: 'Limonada de barrio', note: 'Limón exprimido · hierbabuena · hielo', price: '3,50 €', image: 'photo-1544145945-f90425340c7e', alt: 'Bebida de limón fresca con hielo', key: 'drink1' },
    { tag: 'Clásico', name: 'Refresco bien frío', note: 'Pregunta por los sabores disponibles', price: '2,80 €', image: 'photo-1544145945-f90425340c7e', alt: 'Refresco servido con hielo y cítricos', key: 'drink2' },
  ] },
];
const filters = [
  { id: 'all', label: 'Todos' }, { id: 'burgers', label: 'Burgers' }, { id: 'entrantes', label: 'Entrantes' },
  { id: 'postres', label: 'Postres' }, { id: 'bebidas', label: 'Bebidas' },
];
const fallbackImages: Record<string, string> = {
  burgers: 'burger.webp',
  entrantes: 'fries.webp',
  postres: 'brownie.webp',
  bebidas: 'drink.webp',
};
const imageFiles: Record<string, string> = {
  'photo-1550547660-d9450f859349': 'burger.webp',
  'photo-1568901346375-23c9450c58cd': 'burger-spicy.webp',
  'photo-1520072959219-c595dc870360': 'burger-veggie.webp',
  'photo-1573080496219-bb080dd4f877': 'fries.webp',
  'photo-1527477396000-e27163b481c2': 'wings.webp',
  'photo-1606313564200-e75d5e30476c': 'brownie.webp',
  'photo-1533134242443-d4fd215305ad': 'cheesecake.webp',
  'photo-1544145945-f90425340c7e': 'drink.webp',
};
---
<section id="menu" class="bg-ink px-5 py-24 md:px-10 md:py-32" aria-labelledby="menu-heading">
  <div class="mx-auto max-w-7xl">
    <div class="reveal mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="mb-4 text-[10px] font-black uppercase tracking-[.25em] text-lime" data-i18n="menu.eyebrow">La carta · edición Xàtiva</p><h2 id="menu-heading" class="display text-5xl leading-[.9] md:text-7xl"><span data-i18n="menu.titleLine1">Esto sí</span><br /><span data-i18n="menu.titleLine2">es</span> <span class="text-lime" data-i18n="menu.titleAccent">contenido.</span></h2></div><p class="max-w-sm text-sm leading-6 text-white/55" data-i18n="menu.description">Producto sin postureo, combinaciones con intención y salsas hechas aquí. Desliza el dedo; luego nos das las gracias.</p></div>
    <div class="reveal mb-10 flex flex-wrap gap-2" role="group" aria-label="Filtrar productos por categoría" data-i18n-aria="menu.filterLabel">
      {filters.map((filter, index) => <button type="button" class={`menu-filter focus-ring border px-4 py-3 text-[10px] font-bold uppercase tracking-[.14em] transition ${index === 0 ? 'is-active border-lime bg-lime text-black' : 'border-white/20 bg-transparent text-white hover:border-lime hover:text-lime'}`} data-filter={filter.id} data-i18n={`filter.${filter.id === 'all' ? 'all' : filter.id === 'burgers' ? 'burgers' : filter.id === 'entrantes' ? 'starters' : filter.id === 'postres' ? 'desserts' : 'drinks'}`} aria-pressed={index === 0 ? 'true' : 'false'}>{filter.label}</button>)}
    </div>
    {categories.map((category) => <section class="menu-category mb-14 last:mb-0" data-menu-category-group={category.id} aria-labelledby={`category-${category.id}`}>
      <div class="reveal mb-5 flex items-end justify-between border-b border-white/15 pb-3"><div><h3 id={`category-${category.id}`} class="display text-3xl md:text-4xl"><span data-i18n={`menu.category.${category.id}`}>{category.title}</span><span class="text-lime">.</span></h3><p class="mt-2 text-xs text-white/55" data-i18n={`menu.intro.${category.id}`}>{category.intro}</p></div><span class="text-[10px] uppercase tracking-[.2em] text-white/55">{category.items.length} <span data-i18n="menu.options">opciones</span></span></div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {category.items.map((item) => <article class="reveal food-card group overflow-hidden border border-white/10 bg-panel" data-menu-card={category.id}>
          <div class="relative aspect-[1.25] overflow-hidden"><img class="food-image h-full w-full object-cover" src={`${import.meta.env.BASE_URL}/images/${imageFiles[item.image]}`} data-menu-image data-fallback-src={`${import.meta.env.BASE_URL}/images/${fallbackImages[category.id]}`} alt={item.alt} data-i18n-alt={`menu.item.${item.key}.alt`} width="960" height="640" loading="lazy" decoding="async" /><span class="absolute left-3 top-3 bg-lime px-3 py-2 text-[9px] font-bold uppercase tracking-[.17em] text-black" data-i18n={`menu.item.${item.key}.tag`}>{item.tag}</span><span class="absolute bottom-3 right-3 bg-ink/85 px-3 py-2 text-xs font-black text-lime backdrop-blur">{item.price}</span></div>
          <div class="flex min-h-32 items-end justify-between gap-3 p-4"><div><h4 class="display text-xl leading-tight" data-i18n={`menu.item.${item.key}.name`}>{item.name}</h4><p class="mt-2 text-[11px] leading-5 text-white/50" data-i18n={`menu.item.${item.key}.note`}>{item.note}</p></div><button type="button" class="focus-ring inline-flex shrink-0 items-center gap-1 bg-lime px-3 py-3 text-[10px] font-bold uppercase tracking-wider text-black transition hover:bg-white" data-add-to-cart data-product-id={item.key} data-product-name={item.name} data-i18n-product-name={`menu.item.${item.key}.name`} data-product-price={Number(item.price.replace(',', '.').replace(' €', ''))} aria-label={`Añadir ${item.name} al carrito`}> <span data-i18n="menu.add">Añadir</span> <Icon name="plus" class="h-3 w-3" /></button></div>
        </article>)}
      </div>
    </section>)}
    <p class="mt-7 text-[10px] text-white/55" data-i18n="menu.allergens">Precios e ingredientes orientativos para esta demo. Consulta al equipo por alérgenos.</p>
    <div class="reveal mt-10 flex flex-col items-start justify-between gap-5 border border-lime/25 bg-lime/5 p-6 sm:flex-row sm:items-center md:p-8"><div><p class="display text-2xl" data-i18n="menu.ctaTitle">¿Ya te ha entrado hambre?</p><p class="mt-2 text-sm text-white/55" data-i18n="menu.ctaText">Pásate por Xàtiva o llámanos para hacer tu pedido.</p></div><a href="#reservas" class="focus-ring inline-flex shrink-0 items-center gap-2 bg-lime px-6 py-4 text-xs font-bold uppercase tracking-wider text-black transition hover:bg-white"><span data-i18n="menu.ctaButton">Pedir ahora</span><Icon name="arrow-up-right" /></a></div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-menu-image]').forEach((image) => {
    image.addEventListener('error', () => {
      const fallback = image.dataset.fallbackSrc;
      if (!fallback || image.dataset.fallbackApplied) return;
      image.dataset.fallbackApplied = 'true';
      image.closest('picture')?.querySelectorAll('source').forEach((source) => source.remove());
      image.src = fallback;
    });
  });

  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const menuCards = [...document.querySelectorAll<HTMLElement>('[data-menu-card]')];
  const menuGroups = [...document.querySelectorAll<HTMLElement>('[data-menu-category-group]')];
  const filterTimeouts = new WeakMap<HTMLElement, number>();
  const addButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart][data-i18n-product-name^="menu.item."]')];

  function updateAddButtonLabels() {
    const isValencian = document.documentElement.lang === 'ca-valencia';
    addButtons.forEach((button) => {
      const name = button.dataset.productName ?? '';
      button.setAttribute('aria-label', isValencian ? `Afegir ${name} a la cistella` : `Añadir ${name} al carrito`);
    });
  }
  updateAddButtonLabels();
  window.addEventListener('app:language-change', updateAddButtonLabels);

  filterButtons.forEach((button) => button.addEventListener('click', () => {
    const selected = button.dataset.filter ?? 'all';
    filterButtons.forEach((item) => {
      const active = item === button;
      item.setAttribute('aria-pressed', String(active));
      item.classList.toggle('is-active', active);
      item.classList.toggle('border-lime', active);
      item.classList.toggle('bg-lime', active);
      item.classList.toggle('text-black', active);
      item.classList.toggle('hover:bg-white', active);
      item.classList.toggle('border-white/20', !active);
      item.classList.toggle('bg-transparent', !active);
      item.classList.toggle('text-white', !active);
      item.classList.toggle('hover:border-lime', !active);
      item.classList.toggle('hover:text-lime', !active);
    });

    menuCards.forEach((card) => {
      const shouldShow = selected === 'all' || card.dataset.menuCard === selected;
      const existingTimer = filterTimeouts.get(card);
      if (existingTimer) window.clearTimeout(existingTimer);
      if (shouldShow) {
        card.hidden = false;
        requestAnimationFrame(() => card.classList.remove('menu-filter-out'));
      } else {
        card.classList.add('menu-filter-out');
        const timer = window.setTimeout(() => { card.hidden = true; }, 190);
        filterTimeouts.set(card, timer);
      }
    });
    menuGroups.forEach((group) => {
      group.hidden = selected !== 'all' && group.dataset.menuCategoryGroup !== selected;
    });
  }));
</script>
