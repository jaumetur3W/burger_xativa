---
import Icon from './Icon.astro';
---
<section class="px-5 pb-16 md:px-10 md:pb-24" aria-labelledby="secret-teaser-heading">
  <div class="reveal mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 border border-white/10 bg-[#11110d] p-6 sm:flex-row sm:items-center md:p-9">
    <div><p class="text-[10px] font-black uppercase tracking-[.23em] text-lime" data-i18n="secret.eyebrow">Fuera de carta</p><h2 id="secret-teaser-heading" class="display mt-3 text-3xl md:text-4xl" data-i18n="secret.title">El menú secreto del chef.</h2><p class="mt-3 max-w-2xl text-sm leading-6 text-white/60" data-i18n="secret.description">Monta una smash fuera de carta: elige el punto, suma extras y añade tu combinación al carrito.</p></div>
    <button id="secret-menu-open" type="button" class="focus-ring inline-flex shrink-0 items-center gap-2 border border-lime px-5 py-4 text-xs font-black uppercase tracking-wider text-lime transition hover:bg-lime hover:text-black" aria-haspopup="dialog" aria-controls="secret-menu-dialog"><span data-i18n="secret.open">Crear mi burger</span><Icon name="arrow-up-right" /></button>
  </div>
</section>

<dialog id="secret-menu-dialog" class="secret-dialog fixed inset-0 m-auto max-h-[90dvh] w-[min(92vw,38rem)] overflow-y-auto border border-white/15 bg-ink p-0 text-white shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="secret-dialog-title" aria-describedby="secret-dialog-note">
  <div class="flex items-start justify-between gap-5 border-b border-white/10 p-5 md:p-7"><div><p class="text-[10px] font-black uppercase tracking-[.2em] text-lime" data-i18n="secret.eyebrow">Fuera de carta</p><h2 id="secret-dialog-title" class="display mt-2 text-3xl md:text-4xl" data-i18n="secret.dialogTitle">Diseña tu smash.</h2></div><button type="button" data-dialog-close data-i18n-aria="secret.close" class="focus-ring grid h-11 w-11 shrink-0 place-items-center border border-white/20" aria-label="Cerrar menú secreto"><Icon name="close" /></button></div>
  <form id="secret-builder" class="space-y-6 p-5 md:p-7">
    <fieldset><legend class="mb-3 text-xs font-black uppercase tracking-wider" data-i18n="secret.cook">Punto de la carne</legend><div class="grid grid-cols-3 gap-2"><label class="choice-tile"><input type="radio" name="cook" value="jugosa" checked /><span data-i18n="secret.rare">Jugosa</span></label><label class="choice-tile"><input type="radio" name="cook" value="al punto" /><span data-i18n="secret.medium">Al punto</span></label><label class="choice-tile"><input type="radio" name="cook" value="hecha" /><span data-i18n="secret.well">Hecha</span></label></div></fieldset>
    <fieldset><legend class="mb-3 text-xs font-black uppercase tracking-wider" data-i18n="secret.extras">Extras artesanos</legend><div class="grid gap-3 sm:grid-cols-2"><label class="extra-choice"><input type="checkbox" name="extra" value="Bacon crujiente" data-price="1.5" /><span><span data-i18n="secret.extra1">Bacon crujiente</span> <strong>+1,50 €</strong></span></label><label class="extra-choice"><input type="checkbox" name="extra" value="Queso azul" data-price="1.2" /><span><span data-i18n="secret.extra2">Queso azul</span> <strong>+1,20 €</strong></span></label><label class="extra-choice"><input type="checkbox" name="extra" value="Jalapeño encurtido" data-price="0.8" /><span><span data-i18n="secret.extra3">Jalapeño encurtido</span> <strong>+0,80 €</strong></span></label><label class="extra-choice"><input type="checkbox" name="extra" value="Huevo a la plancha" data-price="1.3" /><span><span data-i18n="secret.extra4">Huevo a la plancha</span> <strong>+1,30 €</strong></span></label></div></fieldset>
    <p id="secret-dialog-note" class="text-xs leading-5 text-white/60" data-i18n="secret.note">Base smash de vacuno, doble cheddar y salsa de la casa. Precio base: 11,90 €.</p>
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-5"><p class="text-sm"><span data-i18n="secret.total">Total</span> <strong id="secret-total" class="display ml-2 text-2xl text-lime">11,90 €</strong></p><button id="secret-add" type="button" class="focus-ring inline-flex items-center gap-2 bg-lime px-5 py-4 text-xs font-bold uppercase tracking-wider text-black transition hover:bg-white"><span data-i18n="secret.add">Añadir combinación</span><Icon name="plus" /></button></div>
  </form>
</dialog>

<script>
  const secretDialog = document.querySelector<HTMLDialogElement>('#secret-menu-dialog');
  const secretOpen = document.querySelector<HTMLButtonElement>('#secret-menu-open');
  const secretBuilder = document.querySelector<HTMLFormElement>('#secret-builder');
  const secretAdd = document.querySelector<HTMLButtonElement>('#secret-add');
  const secretTotal = document.querySelector<HTMLElement>('#secret-total');
  const secretClose = document.querySelector<HTMLButtonElement>('[data-dialog-close]');
  const basePrice = 11.9;
  const currency = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });

  function updateSecretBurger() {
    if (!secretBuilder || !secretAdd || !secretTotal) return;
    const extras = [...secretBuilder.querySelectorAll<HTMLInputElement>('input[name="extra"]:checked')];
    const price = basePrice + extras.reduce((sum, input) => sum + Number(input.dataset.price ?? 0), 0);
    const cook = secretBuilder.querySelector<HTMLInputElement>('input[name="cook"]:checked')?.value ?? 'jugosa';
    const isValencian = document.documentElement.lang === 'ca-valencia';
    const cookName = isValencian
      ? (({ jugosa: 'sucosa', 'al punto': 'al punt', hecha: 'feta' } as Record<string, string>)[cook] ?? cook)
      : cook;
    const extraNames: Record<string, string> = isValencian
      ? { 'Bacon crujiente': 'Bacó cruixent', 'Queso azul': 'Formatge blau', 'Jalapeño encurtido': 'Jalapeño envinagrat', 'Huevo a la plancha': 'Ou a la planxa' }
      : {};
    const name = `${isValencian ? 'Smash del Xef' : 'Smash del Chef'} (${cookName}${extras.length ? `, ${extras.map((item) => extraNames[item.value] ?? item.value).join(', ')}` : ''})`;
    secretTotal.textContent = currency.format(price);
    secretAdd.dataset.productId = `smash-chef-${cook.replaceAll(' ', '-')}-${extras.map((item) => item.value.toLowerCase().replaceAll(' ', '-')).join('-') || 'clasica'}`;
    secretAdd.dataset.productName = name;
    secretAdd.dataset.productPrice = price.toFixed(2);
  }

  secretOpen?.addEventListener('click', () => {
    if (secretDialog && !secretDialog.open) {
      secretDialog.showModal();
      secretClose?.focus();
    }
  });
  secretClose?.addEventListener('click', () => secretDialog?.close());
  secretDialog?.addEventListener('click', (event) => {
    if (event.target === secretDialog) secretDialog.close();
  });
  secretBuilder?.addEventListener('change', updateSecretBurger);
  window.addEventListener('app:language-change', updateSecretBurger);
  secretAdd?.addEventListener('click', () => {
    updateSecretBurger();
    window.setTimeout(() => secretDialog?.close(), 80);
  });
  updateSecretBurger();
</script>
