---
const photos = [
  { image: 'hero.webp', alt: 'Hamburguesa completa con pan de sésamo, carne, queso y vegetales', caption: 'La burger, sin recortes', altKey: 'gallery.alt1', captionKey: 'gallery.caption1' },
  { image: 'burger.webp', alt: 'Hamburguesa artesanal con queso fundido y cebolla', caption: 'Capas hechas para mancharse', altKey: 'gallery.alt2', captionKey: 'gallery.caption2' },
  { image: 'fries.webp', alt: 'Patatas fritas doradas listas para compartir', caption: 'Entrantes para abrir boca', altKey: 'gallery.alt3', captionKey: 'gallery.caption3' },
  { image: 'brownie.webp', alt: 'Brownie de chocolate servido como postre', caption: 'El último bocado', altKey: 'gallery.alt4', captionKey: 'gallery.caption4' },
];
---

<section id="fotos" class="px-5 py-16 md:px-10 md:py-20" aria-labelledby="gallery-heading">
  <div class="mx-auto max-w-7xl">
    <div class="reveal mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="mb-3 text-[10px] font-black uppercase tracking-[.25em] text-lime" data-i18n="gallery.eyebrow">La carta también entra por los ojos</p>
        <h2 id="gallery-heading" class="display text-4xl md:text-5xl"><span data-i18n="gallery.title">Un vistazo al antojo</span><span class="text-lime">.</span></h2>
      </div>
      <p class="max-w-md text-xs leading-5 text-white/55" data-i18n="gallery.note">Fotografías ilustrativas para esta demo. Sustitúyelas por imágenes propias antes de publicar.</p>
    </div>
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {photos.map((photo) => <figure class="reveal food-card group relative aspect-[4/5] overflow-hidden bg-panel">
        <img class="food-image h-full w-full object-cover" src={`${import.meta.env.BASE_URL}/images/${photo.image}`} alt={photo.alt} data-i18n-alt={photo.altKey} width="960" height="640" loading="lazy" decoding="async" />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 to-transparent px-3 pb-3 pt-12 text-xs font-bold text-white sm:px-4 sm:pb-4" data-i18n={photo.captionKey}>{photo.caption}</figcaption>
      </figure>)}
    </div>
  </div>
</section>
