---
const photos = [
  { image: 'photo-1571091718767-18b5b1457add', alt: 'Hamburguesa completa con pan de sésamo, carne, queso y vegetales', caption: 'La burger, sin recortes' },
  { image: 'photo-1553979459-d2229ba7433a', alt: 'Hamburguesa artesanal con queso fundido y cebolla', caption: 'Capas hechas para mancharse' },
  { image: 'photo-1573080496219-bb080dd4f877', alt: 'Patatas fritas doradas listas para compartir', caption: 'Entrantes para abrir boca' },
  { image: 'photo-1606313564200-e75d5e30476c', alt: 'Brownie de chocolate servido como postre', caption: 'El último bocado' },
];
---

<section id="fotos" class="px-5 py-16 md:px-10 md:py-20" aria-labelledby="gallery-heading">
  <div class="mx-auto max-w-7xl">
    <div class="reveal mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="mb-3 text-[10px] font-black uppercase tracking-[.25em] text-lime">La carta también entra por los ojos</p>
        <h2 id="gallery-heading" class="display text-4xl md:text-5xl">Un vistazo al antojo<span class="text-lime">.</span></h2>
      </div>
      <p class="max-w-md text-xs leading-5 text-white/55">Fotografías ilustrativas para esta demo. Sustitúyelas por imágenes propias antes de publicar.</p>
    </div>
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {photos.map((photo) => <figure class="reveal food-card group relative aspect-[4/5] overflow-hidden bg-panel">
        <picture>
          <source type="image/avif" srcset={`https://images.unsplash.com/${photo.image}?fit=crop&w=360&h=450&q=72&fm=avif 360w, https://images.unsplash.com/${photo.image}?fit=crop&w=640&h=800&q=72&fm=avif 640w, https://images.unsplash.com/${photo.image}?fit=crop&w=900&h=1125&q=72&fm=avif 900w`} sizes="(max-width: 639px) 45vw, (max-width: 1023px) 22vw, 25vw" />
          <source type="image/webp" srcset={`https://images.unsplash.com/${photo.image}?fit=crop&w=360&h=450&q=72&fm=webp 360w, https://images.unsplash.com/${photo.image}?fit=crop&w=640&h=800&q=72&fm=webp 640w, https://images.unsplash.com/${photo.image}?fit=crop&w=900&h=1125&q=72&fm=webp 900w`} sizes="(max-width: 639px) 45vw, (max-width: 1023px) 22vw, 25vw" />
          <img class="food-image h-full w-full object-cover" src={`https://images.unsplash.com/${photo.image}?fit=crop&w=640&h=800&q=72&fm=webp`} alt={photo.alt} width="640" height="800" loading="lazy" decoding="async" />
        </picture>
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 to-transparent px-3 pb-3 pt-12 text-xs font-bold text-white sm:px-4 sm:pb-4">{photo.caption}</figcaption>
      </figure>)}
    </div>
  </div>
</section>
