---
---
<a href="#contenido" class="focus-ring sr-only fixed left-3 top-3 z-[60] bg-lime px-4 py-3 text-xs font-black uppercase text-ink focus:not-sr-only">Saltar al contenido</a>
<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 md:px-10">
    <a class="display kinetic-logo shrink-0 text-sm text-white md:text-base" href="#inicio" aria-label="Burger Xàtiva Demo, inicio" data-logo-shutter aria-busy="true"><span data-logo-wordmark>BURGER<span class="text-lime">.</span> XÀTIVA <span class="text-lime">DEMO</span></span></a>
    <nav class="hidden items-center gap-5 lg:flex" aria-label="Navegación principal">
      <a class="header-link" href="#menu">Menú</a><a class="header-link" href="#promociones">Promociones</a><a class="header-link" href="#reservas">Reservas</a><a class="header-link" href="#contacto">Ubicación</a><a class="header-link" href="#faq">FAQ</a>
    </nav>
    <div class="flex shrink-0 items-center gap-2">
      <a class="focus-ring hidden border border-white/20 px-4 py-3 text-[10px] font-black uppercase tracking-wider transition hover:border-lime hover:text-lime sm:inline-flex" href="#reservas">Reservar</a>
      <button type="button" data-cart-trigger class="focus-ring inline-flex items-center gap-2 bg-lime px-3 py-3 text-[10px] font-black uppercase tracking-wider text-ink transition hover:bg-white" aria-haspopup="dialog" aria-controls="cart-dialog" aria-expanded="false" aria-label="Abrir carrito, 0 productos">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
        <span class="hidden sm:inline">Carrito</span><span id="header-cart-count" class="grid h-5 min-w-5 place-items-center rounded-full bg-ink px-1 text-[9px] text-lime" aria-label="0 productos">0</span>
      </button>
    </div>
  </div>
  <nav class="scrollbar-none flex gap-5 overflow-x-auto border-t border-white/5 px-5 py-2 lg:hidden" aria-label="Navegación rápida">
    <a class="header-link" href="#menu">Menú</a><a class="header-link" href="#promociones">Promociones</a><a class="header-link" href="#reservas">Reservas</a><a class="header-link" href="#contacto">Ubicación</a><a class="header-link" href="#faq">FAQ</a>
  </nav>
</header>
<style>
  .header-link { flex: none; font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: rgb(255 255 255 / .65); transition: color .2s; }
  .header-link:hover, .header-link:focus-visible { color: #ffff00; }
  .scrollbar-none { scrollbar-width: none; }
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .kinetic-logo { display: inline-block; transform-origin: left center; }
  .kinetic-logo[data-logo-shutter] { animation: logo-shutter 1.35s cubic-bezier(.2,.75,.25,1) both; }
  .kinetic-logo[data-logo-variant="serif"] [data-logo-wordmark] { font-family: Georgia, "Times New Roman", serif; font-weight: 900; letter-spacing: -.045em; }
  .kinetic-logo[data-logo-variant="mono"] [data-logo-wordmark] { font-family: "Courier New", monospace; font-weight: 900; letter-spacing: -.09em; }
  .kinetic-logo[data-logo-variant="slab"] [data-logo-wordmark] { font-family: Rockwell, "Arial Black", serif; font-weight: 900; letter-spacing: -.08em; }
  .kinetic-logo[data-logo-variant="italic"] [data-logo-wordmark] { font-family: Impact, Haettenschweiler, sans-serif; font-style: italic; letter-spacing: -.075em; }
  .kinetic-logo[data-logo-variant="industrial"] [data-logo-wordmark] { font-family: "Arial Narrow", Impact, sans-serif; font-weight: 900; letter-spacing: -.055em; }
  .kinetic-logo[data-logo-variant="final"] [data-logo-wordmark] { font-family: "Arial Black", Impact, sans-serif; font-style: normal; letter-spacing: -.065em; }
  @keyframes logo-shutter { 0% { opacity: 0; filter: blur(5px); transform: translateY(5px) scaleX(.94); } 38% { opacity: 1; filter: blur(0); transform: translateY(0) scaleX(1.015); } 68% { transform: scaleX(.995); } 100% { opacity: 1; filter: none; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .kinetic-logo[data-logo-shutter] { animation: none; } }
</style>
<script>
  const logo = document.querySelector<HTMLElement>('[data-logo-shutter]');
  if (logo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const variants = ['serif', 'mono', 'slab', 'italic', 'industrial', 'mono', 'serif', 'final'];
    let frame = 0;
    const shutter = window.setInterval(() => {
      logo.dataset.logoVariant = variants[frame] ?? 'final';
      frame += 1;
      if (frame >= variants.length) {
        window.clearInterval(shutter);
        logo.dataset.logoVariant = 'final';
        window.setTimeout(() => {
          logo.removeAttribute('data-logo-shutter');
          logo.setAttribute('aria-busy', 'false');
        }, 170);
      }
    }, 145);
  } else {
    logo?.setAttribute('aria-busy', 'false');
    if (logo) logo.dataset.logoVariant = 'final';
  }
</script>
