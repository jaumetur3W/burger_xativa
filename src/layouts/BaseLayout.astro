---
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; }
const { title = 'Burger Xàtiva — Demo de portfolio', description = 'Hamburguesas de autor, ingredientes de verdad y mucho fuego. Una experiencia burger urbana en Xàtiva. Proyecto de demostración.', image = 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1200&q=85' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://demo.example').toString();
const schema = {
  '@context': 'https://schema.org', '@type': ['Restaurant', 'LocalBusiness'],
  name: 'Burger Xàtiva (Demo)', description,
  servesCuisine: ['Hamburguesas', 'Americana'], priceRange: '€€',
  menu: `${canonical}#menu`,
  additionalProperty: { '@type': 'PropertyValue', name: 'Estado del dato', value: 'Información de demostración; dirección, teléfono y horarios ficticios' },
  image: new URL(image, Astro.site ?? 'https://demo.example').toString(),
  address: { '@type': 'PostalAddress', streetAddress: 'Dirección de ejemplo', addressLocality: 'Xàtiva', addressRegion: 'Valencia', postalCode: '46800', addressCountry: 'ES' },
  telephone: '+34 000 000 000', url: canonical,
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '13:00', closes: '23:00' }],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? 'https://demo.example').toString()} />
    <meta property="og:image:alt" content="Hamburguesa de demostración para la plantilla Burger Xàtiva" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? 'https://demo.example').toString()} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body><slot /><script>import '../scripts/scroll-reveal';</script></body>
</html>
